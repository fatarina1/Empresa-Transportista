			"name": "1. Autenticación",
			"item": [
				{
					"name": "Login como CLIENTE",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Guardar el token automáticamente",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"access_token_cliente\", jsonData.access_token);",
									"    console.log(\"✅ Token de CLIENTE guardado\");",
									"    ",
									"    // Decodificar y mostrar info del token",
									"    var base64Url = jsonData.access_token.split('.')[1];",
									"    var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
									"    var payload = JSON.parse(atob(base64));",
									"    ",
									"    console.log(\"👤 Usuario:\", payload.preferred_username);",
									"    console.log(\"🎭 Roles:\", payload.resource_access['tpi-backend-client'].roles);",
									"    console.log(\"⏰ Expira en:\", jsonData.expires_in, \"segundos\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{client_id}}",
									"type": "text"
								},
								{
									"key": "username",
									"value": "cliente01",
									"type": "text"
								},
								{
									"key": "password",
									"value": "Hola123",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
							"host": [
								"{{keycloak_url}}"
							],
							"path": [
								"realms",
								"{{realm}}",
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Obtiene un token JWT para el usuario cliente01 con rol 'cliente'"
					},
					"response": []
				},
