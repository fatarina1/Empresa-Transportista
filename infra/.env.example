# ===================================
# Variables de Entorno para Docker
# ===================================
# Copia este archivo como .env y configura los valores necesarios
# cp .env.example .env

# ----- Keycloak Configuration -----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ----- Google Maps API (para geoapi) -----
# Obtén tu API Key en: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_APIKEY=TU_GOOGLE_MAPS_API_KEY_AQUI

# ----- Logística Service -----
VALOR_LITRO_COMBUSTIBLE=450.0

# ----- Database (opcional - por defecto usa H2 en memoria) -----
# Si quieres usar PostgreSQL u otra BD:
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tpi_db
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres123

# ===================================
# Notas:
# ===================================
# - Las URLs de Keycloak se configuran automáticamente en docker-compose.yml
# - Los microservicios usan http://keycloak:8080 internamente
# - Desde tu navegador accedes a http://localhost:8180
# - El gateway está en http://localhost:8080
