# Example environment variables for docker-compose
# Copy this file to `.env` and fill the sensitive values. Do NOT commit the real `.env` with secrets.

# Google Maps API key (DO NOT COMMIT THE REAL KEY)
GOOGLE_MAPS_APIKEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY

# Keycloak admin credentials (change for production)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Default values
VALOR_LITRO_COMBUSTIBLE=450.0
