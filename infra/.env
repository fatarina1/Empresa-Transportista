# Environment variables for docker-compose
# Copy your real Google Maps API key here. Do NOT commit this file to git.
# Set `GOOGLE_MAPS_APIKEY` in your local `.env` (this repo contains `.env` for demo but should not include real keys).
GOOGLE_MAPS_APIKEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY

# Keycloak admin credentials (change for production)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Default values
VALOR_LITRO_COMBUSTIBLE=450.0
