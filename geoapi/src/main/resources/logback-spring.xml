<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Appender para CONSOLA (stdout/stderr para Docker) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [CID=%X{correlationId}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Logger específico del servicio -->
    <logger name="utnfc.isi.back.spring.geoapi" level="DEBUG"/>

    <!-- Root logger - solo CONSOLA -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    
</configuration>
